{
  "name": "@palanikannan1437/rc4community-navbar",
  "version": "2.1.4",
  "description": "",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/*.d.ts",
  "exports": {
    ".": {
      "react-server": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/**/*.{js,d.ts,css}"
  ],
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "index": [
          "dist/index.d.ts"
        ],
        "api": [
          "dist/api/index.d.ts"
        ],
        "*": []
      }
    }
  },
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "pnpm build:postcss && pnpm build:swc && pnpm types",
    "build:swc": "swc src -d dist --copy-files",
    "build:postcss": "postcss src/index.css -o src/styles.css --minify",
    "dev": "pnpm build:swc -w && pnpm dev:postcss",
    "dev:postcss": "postcss src/index.css -o src/styles.css --watch",
    "types": "tsc --emitDeclarationOnly",
    "lint": "TIMING=1 eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "clean": "rm -rf dist && rm -rf .turbo"
  },
  "devDependencies": {
    "@types/react": "^18.0.26",
    "autoprefixer": "^10.4.13",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.66",
    "eslint": "^7.32.0",
    "eslint-config-custom": "workspace:*",
    "postcss": "^8.4.20",
    "react": "^18.2.0",
    "tailwind-config": "workspace:*",
    "tailwindcss": "^3.2.4",
    "tsconfig": "workspace:*",
    "tsup": "^6.5.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.1",
    "@radix-ui/react-navigation-menu": "^1.1.1",
    "class-variance-authority": "^0.4.0",
    "clsx": "^1.2.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "lucide-react": "^0.115.0",
    "qs": "^6.11.0",
    "tailwind-merge": "^1.9.1",
    "tailwindcss-animate": "^1.0.5"
  }
}
